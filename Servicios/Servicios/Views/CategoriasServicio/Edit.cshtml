@model Servicios.Models.CategoriaServicio

@{
    ViewData["Title"] = "Editar categoría de servicio";
}

<h1 class="text-2xl md:text-3xl font-semibold text-neutral-900 mb-4">
    Editar categoría de servicio
</h1>

<form asp-action="Edit" method="post"
      class="bg-white rounded-2xl shadow-sm p-6 space-y-4">
    @Html.HiddenFor(m => m.Id)

    <div>
        <label asp-for="Nombre" class="block text-xs font-medium text-neutral-600 mb-1"></label>
        <input asp-for="Nombre"
               class="w-full rounded-xl border border-neutral-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-neutral-900" />
        <span asp-validation-for="Nombre" class="text-xs text-red-600"></span>
    </div>
    <div>
        <label asp-for="Descripcion" class="block text-xs font-medium text-neutral-600 mb-1"></label>
        <textarea asp-for="Descripcion" rows="3"
                  class="w-full rounded-xl border border-neutral-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-neutral-900"></textarea>
        <span asp-validation-for="Descripcion" class="text-xs text-red-600"></span>
    </div>
    <div class="flex items-center gap-2">
        <input asp-for="Activo" type="checkbox"
               class="rounded border-neutral-300 text-neutral-900 focus:ring-neutral-900" />
        <label asp-for="Activo" class="text-xs text-neutral-700">Activa</label>
    </div>

    <div class="flex items-center justify-between pt-4 border-t border-neutral-100">
        <a asp-action="Index"
           class="text-xs font-medium text-neutral-500 hover:text-neutral-800">
            ← Volver al listado
        </a>
        <button type="submit"
                class="inline-flex items-center px-4 py-2 rounded-xl text-sm font-semibold bg-neutral-900 text-neutral-50 hover:bg-neutral-800">
            Guardar cambios
        </button>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
