@model IEnumerable<Servicios.Models.CategoriaServicio>

@{
    ViewData["Title"] = "Categorías de servicio";
    var buscar = ViewBag.Buscar as string;
    bool mostrarInactivas = ViewBag.MostrarInactivas ?? false;
    int paginaActual = ViewBag.PaginaActual ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 1;
    int totalRegistros = ViewBag.TotalRegistros ?? 0;
    int tamPagina = ViewBag.TamPagina ?? 10;
}

<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="text-2xl md:text-3xl font-semibold text-neutral-900">
            Categorías de servicio
        </h1>
        <p class="text-sm text-neutral-500">
            Clasifica los tipos de servicios de mano de obra del taller.
        </p>
    </div>
    <a asp-action="Create"
       class="inline-flex items-center px-4 py-2 rounded-xl text-sm font-medium bg-neutral-900 text-neutral-50 hover:bg-neutral-800">
        + Nueva categoría
    </a>
</div>

<form method="get" class="mb-4 grid gap-3 md:grid-cols-4 bg-white p-4 rounded-2xl shadow-sm">
    <div class="md:col-span-2">
        <label class="block text-xs font-medium text-neutral-600 mb-1">Buscar</label>
        <input type="text" name="buscar" value="@buscar"
               class="w-full rounded-xl border border-neutral-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-neutral-900"
               placeholder="Nombre o descripción" />
    </div>

    <div class="flex items-center gap-2 mt-6">
        <input type="checkbox" name="mostrarInactivas" value="true"
               @(mostrarInactivas ? "checked" : "") />
        <span class="text-xs text-neutral-700">Mostrar también inactivas</span>
    </div>

    <div class="flex items-end justify-end mt-2">
        <button type="submit"
                class="inline-flex items-center px-4 py-2 rounded-xl text-xs font-semibold bg-neutral-900 text-neutral-50 hover:bg-neutral-800">
            Filtrar
        </button>
    </div>
</form>

<div class="bg-white rounded-2xl shadow-sm overflow-x-auto">
    <table class="min-w-full text-sm">
        <thead class="border-b border-neutral-200 bg-neutral-50 text-neutral-500">
            <tr>
                <th class="px-4 py-3 text-left font-medium">Nombre</th>
                <th class="px-4 py-3 text-left font-medium">Descripción</th>
                <th class="px-4 py-3 text-left font-medium">Estado</th>
                <th class="px-4 py-3 text-right font-medium">Acciones</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-neutral-100">
            @foreach (var c in Model)
            {
                <tr class="hover:bg-neutral-50">
                    <td class="px-4 py-3 font-medium text-neutral-900">@c.Nombre</td>
                    <td class="px-4 py-3 text-neutral-700">@c.Descripcion</td>
                    <td class="px-4 py-3">
                        @if (c.Activo)
                        {
                            <span class="inline-flex px-2 py-1 rounded-full text-[11px] font-medium bg-green-100 text-green-700">
                                Activa
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex px-2 py-1 rounded-full text-[11px] font-medium bg-red-100 text-red-700">
                                Inactiva
                            </span>
                        }
                    </td>

                    <td class="px-4 py-3 text-right space-x-2">
                        <a asp-action="Edit" asp-route-id="@c.Id"
                           class="text-xs font-medium text-blue-600 hover:text-blue-800">Editar</a>

                        @if (c.Activo)
                        {
                            <form asp-action="Desactivar" asp-route-id="@c.Id" method="post" class="inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="buscar" value="@buscar" />
                                <input type="hidden" name="pagina" value="@paginaActual" />
                                <input type="hidden" name="tamPagina" value="@tamPagina" />

                                <button type="submit"
                                        class="text-xs font-medium text-red-600 hover:text-red-800"
                                        onclick="return confirm('¿Desactivar esta categoría?');">
                                    Desactivar
                                </button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="Activar" asp-route-id="@c.Id" method="post" class="inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="buscar" value="@buscar" />
                                <input type="hidden" name="pagina" value="@paginaActual" />
                                <input type="hidden" name="tamPagina" value="@tamPagina" />

                                <button type="submit"
                                        class="text-xs font-medium text-emerald-600 hover:text-emerald-800">
                                    Activar
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }

            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4" class="px-4 py-6 text-center text-sm text-neutral-500">
                        No hay categorías registradas.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (totalPaginas > 1)
{
    <div class="mt-4 flex items-center justify-between text-xs text-neutral-600">
        <span>
            Página @paginaActual de @totalPaginas · @totalRegistros registros
        </span>
        <div class="flex gap-2">
            @for (var i = 1; i <= totalPaginas; i++)
            {
                <a asp-action="Index"
                   asp-route-pagina="@i"
                   asp-route-tamPagina="@tamPagina"
                   asp-route-buscar="@buscar"
                   asp-route-mostrarInactivas="@mostrarInactivas"
                   class="inline-flex items-center justify-center w-8 h-8 rounded-full border text-xs
                                  @(i == paginaActual ? "bg-neutral-900 text-neutral-50 border-neutral-900" : "border-neutral-200 text-neutral-700 hover:bg-neutral-100")">
                    @i
                </a>
            }
        </div>
    </div>
}
