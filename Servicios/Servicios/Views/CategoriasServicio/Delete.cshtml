@model Servicios.Models.CategoriaServicio

@{
    ViewData["Title"] = "Eliminar categoría de servicio";
}

<h1 class="text-2xl md:text-3xl font-semibold text-neutral-900 mb-4">
    Eliminar categoría de servicio
</h1>

<div class="bg-white rounded-2xl shadow-sm p-6 space-y-4 text-sm">
    <p class="text-sm text-neutral-700 mb-2">
        ¿Seguro que deseas eliminar esta categoría? Si hay servicios asociados, podrías perder la referencia.
    </p>

    <div class="grid md:grid-cols-2 gap-4">
        <div>
            <p class="text-xs text-neutral-500">Nombre</p>
            <p class="font-medium text-neutral-900">@Model.Nombre</p>
        </div>
        <div>
            <p class="text-xs text-neutral-500">Estado</p>
            @if (Model.Activo)
            {
                <span class="inline-flex px-2 py-1 rounded-full text-[11px] font-medium bg-green-100 text-green-700">
                    Activa
                </span>
            }
            else
            {
                <span class="inline-flex px-2 py-1 rounded-full text-[11px] font-medium bg-red-100 text-red-700">
                    Inactiva
                </span>
            }
        </div>
    </div>

    <div>
        <p class="text-xs text-neutral-500">Descripción</p>
        <p class="text-sm text-neutral-800">@Model.Descripcion</p>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-4 flex items-center justify-between text-xs">
    @Html.HiddenFor(m => m.Id)

    <a asp-action="Index"
       class="text-neutral-500 hover:text-neutral-800">
        ← Cancelar y volver al listado
    </a>

    <button type="submit"
            class="inline-flex items-center px-4 py-2 rounded-xl text-sm font-semibold bg-red-600 text-neutral-50 hover:bg-red-700">
        Sí, eliminar categoría
    </button>
</form>
