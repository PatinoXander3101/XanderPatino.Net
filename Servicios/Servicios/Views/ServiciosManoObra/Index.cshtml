@using Microsoft.AspNetCore.Mvc.Rendering
@model Servicios.Models.ViewModels.ServicioManoObraIndexVm

@{
    ViewData["Title"] = "Servicios Mano de Obra";
    var ordenActual = (Model.Filtro.Orden ?? "nombre").ToLowerInvariant();
    var categorias = (IEnumerable<SelectListItem>?)ViewBag.CategoriasFiltro ?? Enumerable.Empty<SelectListItem>();
}

<!-- ================= HEADER ================= -->
<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="text-2xl font-semibold text-neutral-900">Servicios de Mano de Obra</h1>
        <p class="text-sm text-neutral-500">
            Filtra por categoría, garantía y estado activo/inactivo.
        </p>
    </div>

    <!-- ✅ BOTÓN CREAR -->
    <a asp-action="Create"
       class="inline-flex items-center px-4 py-2 rounded-xl text-sm font-semibold
              bg-neutral-900 text-white hover:bg-neutral-800 transition">
        + Nuevo servicio
    </a>
</div>

<!-- ================= FILTROS ================= -->
<form method="get" class="mb-4 grid gap-3 md:grid-cols-5 bg-white p-4 rounded-2xl shadow-sm">

    <div class="md:col-span-2">
        <label class="block text-xs font-medium text-neutral-600 mb-1">Buscar</label>
        <input type="text" name="Buscar" value="@Model.Filtro.Buscar"
               class="w-full rounded-xl border border-neutral-200 px-3 py-2 text-sm"
               placeholder="Nombre o código" />
    </div>

    <div>
        <label class="block text-xs font-medium text-neutral-600 mb-1">Categoría</label>
        <select name="CategoriaServicioId"
                class="w-full rounded-xl border border-neutral-200 px-3 py-2 text-sm">
            <option value="">Todas</option>
            @foreach (var item in categorias)
            {
                if (item.Selected)
                {
                    <option value="@item.Value" selected="selected">@item.Text</option>
                }
                else
                {
                    <option value="@item.Value">@item.Text</option>
                }
            }
        </select>
    </div>

    <div class="flex flex-col gap-1 justify-center">
        <input type="hidden" name="SoloGarantia" value="false" />
        <label class="inline-flex items-center gap-2 text-xs text-neutral-700">
            <input type="checkbox" name="SoloGarantia" value="true"
                   @(Model.Filtro.SoloGarantia == true ? "checked=\"checked\"" : "") />
            Solo garantía
        </label>

        <input type="hidden" name="SoloActivos" value="false" />
        <label class="inline-flex items-center gap-2 text-xs text-neutral-700">
            <input type="checkbox" name="SoloActivos" value="true"
                   @(Model.Filtro.SoloActivos == true ? "checked=\"checked\"" : "") />
            Solo activos
        </label>
    </div>

    <div class="flex flex-col gap-2">
        <label class="block text-xs font-medium text-neutral-600 mb-1">Ordenar por</label>

        <select name="Orden"
                class="w-full rounded-xl border border-neutral-200 px-3 py-2 text-sm">
            @if (ordenActual == "nombre")
            {
                <option value="nombre" selected="selected">Nombre</option>
                ;
            }
            else
            {
                <option value="nombre">Nombre</option>
                ;
            }

            @if (ordenActual == "precioasc")
            {
                <option value="precioAsc" selected="selected">Precio ↑</option>
                ;
            }
            else
            {
                <option value="precioAsc">Precio ↑</option>
                ;
            }

            @if (ordenActual == "preciodesc")
            {
                <option value="precioDesc" selected="selected">Precio ↓</option>
                ;
            }
            else
            {
                <option value="precioDesc">Precio ↓</option>
                ;
            }

            @if (ordenActual == "horas")
            {
                <option value="horas" selected="selected">Horas</option>
                ;
            }
            else
            {
                <option value="horas">Horas</option>
                ;
            }
        </select>

        <div class="flex gap-2">
            <input type="number" name="TamPagina" value="@Model.Filtro.TamPagina"
                   class="w-24 rounded-xl border border-neutral-200 px-2 py-2 text-xs"
                   min="5" max="100" />

            <input type="hidden" name="Pagina" value="1" />

            <button type="submit"
                    class="flex-1 px-3 py-2 rounded-xl text-xs font-semibold bg-neutral-900 text-white">
                Aplicar
            </button>
        </div>
    </div>
</form>

<!-- ================= TABLA ================= -->
<div class="overflow-x-auto bg-white rounded-2xl shadow-sm">
    <table class="min-w-full text-sm">
        <thead class="border-b border-neutral-200 bg-neutral-50 text-neutral-500">
            <tr>
                <th class="px-4 py-3 text-left">Código</th>
                <th class="px-4 py-3 text-left">Servicio</th>
                <th class="px-4 py-3 text-left">Categoría</th>
                <th class="px-4 py-3 text-left">Estado</th>
                <th class="px-4 py-3 text-right">Acciones</th>
            </tr>
        </thead>

        <tbody class="divide-y divide-neutral-100">
            @foreach (var s in Model.Servicios)
            {
                <tr class="hover:bg-neutral-50">
                    <td class="px-4 py-3 font-mono text-xs">@s.Codigo</td>
                    <td class="px-4 py-3 font-medium">@s.Nombre</td>
                    <td class="px-4 py-3">@s.CategoriaServicio?.Nombre</td>

                    <td class="px-4 py-3">
                        @if (s.Activo)
                        {
                            <span class="px-2 py-1 rounded-full text-[11px] bg-green-100 text-green-700">Activo</span>
                        }
                        else
                        {
                            <span class="px-2 py-1 rounded-full text-[11px] bg-red-100 text-red-700">Inactivo</span>
                        }
                    </td>

                    <!-- ============ ACCIONES ============ -->
                    <td class="px-4 py-3 text-right space-x-2">

                        <!-- ✅ DETALLE -->
                        <a asp-action="Details" asp-route-id="@s.Id"
                           class="text-xs font-medium text-sky-600 hover:text-sky-800">
                            Detalle
                        </a>

                        <!-- ✅ EDITAR -->
                        <a asp-action="Edit" asp-route-id="@s.Id"
                           class="text-xs font-medium text-blue-600 hover:text-blue-800">
                            Editar
                        </a>

                        <!-- ✅ ACTIVAR / DESACTIVAR -->
                        @if (s.Activo)
                        {
                            <form asp-action="Desactivar" method="post" class="inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@s.Id" />
                                <input type="hidden" name="Buscar" value="@Model.Filtro.Buscar" />
                                <input type="hidden" name="CategoriaServicioId" value="@Model.Filtro.CategoriaServicioId" />
                                <input type="hidden" name="SoloGarantia" value="@(Model.Filtro.SoloGarantia == true ? "true" : "false")" />
                                <input type="hidden" name="SoloActivos" value="@(Model.Filtro.SoloActivos == true ? "true" : "false")" />
                                <input type="hidden" name="Orden" value="@Model.Filtro.Orden" />
                                <input type="hidden" name="Pagina" value="@Model.Filtro.Pagina" />
                                <input type="hidden" name="TamPagina" value="@Model.Filtro.TamPagina" />

                                <button type="submit"
                                        class="text-xs font-medium text-red-600"
                                        onclick="return confirm('¿Desactivar este servicio?');">
                                    Desactivar
                                </button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="Activar" method="post" class="inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@s.Id" />
                                <input type="hidden" name="Buscar" value="@Model.Filtro.Buscar" />
                                <input type="hidden" name="CategoriaServicioId" value="@Model.Filtro.CategoriaServicioId" />
                                <input type="hidden" name="SoloGarantia" value="@(Model.Filtro.SoloGarantia == true ? "true" : "false")" />
                                <input type="hidden" name="SoloActivos" value="@(Model.Filtro.SoloActivos == true ? "true" : "false")" />
                                <input type="hidden" name="Orden" value="@Model.Filtro.Orden" />
                                <input type="hidden" name="Pagina" value="@Model.Filtro.Pagina" />
                                <input type="hidden" name="TamPagina" value="@Model.Filtro.TamPagina" />

                                <button type="submit"
                                        class="text-xs font-medium text-emerald-600">
                                    Activar
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }

            @if (!Model.Servicios.Any())
            {
                <tr>
                    <td colspan="5" class="px-4 py-6 text-center text-sm text-neutral-500">
                        No se encontraron servicios con los filtros aplicados.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- ================= PAGINACIÓN ================= -->
@if (Model.TotalPaginas > 1)
{
    <div class="mt-4 flex items-center justify-between text-xs text-neutral-600">
        <span>
            Página @Model.PaginaActual de @Model.TotalPaginas · @Model.TotalRegistros registros
        </span>

        <div class="flex gap-2">
            @for (var i = 1; i <= Model.TotalPaginas; i++)
            {
                <a asp-action="Index"
                   asp-route-Pagina="@i"
                   asp-route-TamPagina="@Model.Filtro.TamPagina"
                   asp-route-Buscar="@Model.Filtro.Buscar"
                   asp-route-CategoriaServicioId="@Model.Filtro.CategoriaServicioId"
                   asp-route-SoloGarantia="@Model.Filtro.SoloGarantia"
                   asp-route-SoloActivos="@Model.Filtro.SoloActivos"
                   asp-route-Orden="@Model.Filtro.Orden"
                   class="inline-flex w-8 h-8 items-center justify-center rounded-full border text-xs
                                  @(i == Model.PaginaActual
                                               ? "bg-neutral-900 text-white border-neutral-900"
                                               : "border-neutral-200 text-neutral-700 hover:bg-neutral-100")">
                    @i
                </a>
            }
        </div>
    </div>
}
